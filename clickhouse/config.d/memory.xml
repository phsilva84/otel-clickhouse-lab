<clickhouse>
    <!-- 512 MiB: lab em e2-micro -->
    <max_server_memory_usage>536870912</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_thread_pool_size>200</max_thread_pool_size>
    <background_pool_size>4</background_pool_size>
    <background_schedule_pool_size>4</background_schedule_pool_size>
    <logger><level>warning</level></logger>
    <!-- tabelas system.* de log consomem RAM/disco; desligadas no lab -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
</clickhouse>
